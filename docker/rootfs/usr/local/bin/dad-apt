#!/usr/bin/env bash
# dad-apt: install Debian packages without root, into /home/bot, so they persist with the home volume.
#
#   dad-apt install PKG...   download PKG and the dependencies the image lacks, unpack into the tier
#   dad-apt remove PKG...    delete the files of PKG (files shared with another tier package stay)
#   dad-apt list             tier packages and versions
#   dad-apt update           refresh the package lists (install does this when they are a day old)
#   dad-apt exec CMD [ARG]   run CMD with the tier visible at its real paths
#   dad-apt shell [ARG...]   bash with the tier visible (arguments go to bash)
#   dad-apt refresh          recompute the path view and the wrappers
#
# How it works: apt-get resolves and downloads as the unprivileged user (download only, with lists
# and archives under the tier). Each .deb is unpacked with dpkg-deb -x into $DAD_APT_HOME/root.
# Commands run under proot, which binds the unpacked files over their real absolute paths
# (/usr/bin/jq, /usr/lib/x86_64-linux-gnu/libjq.so.1, /usr/share/<pkg>, ...) for that process only,
# so programs find their libraries and data where Debian put them. The image's own files are
# untouched and everything else is the real system. Every executable gets a wrapper in
# ~/.local/bin (on PATH), so installed commands run by name.
#
# Limits: maintainer scripts (postinst etc.) are not run, so packages that need them (services,
# system users, setuid helpers, alternatives, triggers) do not fully work. Commands run as uid 1000
# under ptrace, which costs some speed on syscall-heavy work. For real root installs use a derived
# image (docs/image.md).
set -euo pipefail

TIER="${DAD_APT_HOME:-$HOME/.local/share/dad-apt}"
ROOT="$TIER/root"
INFO="$TIER/info"
BINDS="$TIER/binds"
BIN_DIR="${DAD_APT_BIN:-$HOME/.local/bin}"
WRAP_MARK="# dad-apt wrapper"
# Docs and manuals are dropped on unpack, like the image's own dpkg excludes.
SKIP_RE='^/usr/share/(doc|man|info|lintian|bug)(/|$)'

die() { echo "dad-apt: $*" >&2; exit 1; }

apt_opts=(
  -o "Dir::State::Lists=$TIER/lists"
  -o "Dir::Cache::archives=$TIER/archives"
  -o "Dir::Cache::pkgcache="
  -o "Dir::Cache::srcpkgcache="
  -o "Debug::NoLocking=1"
  -o "APT::Install-Recommends=false"
)

init() { mkdir -p "$TIER/lists/partial" "$TIER/archives/partial" "$ROOT" "$INFO" "$BIN_DIR"; }

cmd_update() {
  init
  apt-get "${apt_opts[@]}" -q update
}

lists_fresh() {
  [[ -n "$(find "$TIER/lists" -maxdepth 1 -name '*Packages*' -mmin -1440 -print -quit 2>/dev/null)" ]]
}

# tier_target resolves a tier symlink to what proot should bind: absolute targets are looked up in
# the tier first, then on the real system (proot resolves a bound symlink on the host, where an
# absolute target like /usr/bin/figlet-figlet does not exist). Relative targets resolve on the host
# inside the tier already, so they stay.
tier_target() {
  local src="$1" t n=0
  while [[ -L "$src" && $n -lt 16 ]]; do
    t=$(readlink "$src")
    [[ "$t" == /* ]] || break
    if [[ -e "$ROOT$t" || -L "$ROOT$t" ]]; then src="$ROOT$t"; else src="$t"; fi
    n=$((n + 1))
  done
  printf '%s\n' "$src"
}

# refresh computes the bind list (the shallowest path of each tier file whose parent exists on the
# real system, as "SOURCE<TAB>PATH" lines) and rewrites the ~/.local/bin wrappers.
cmd_refresh() {
  init
  local tmp="$BINDS.tmp.$$" f p best
  : >"$tmp"
  if compgen -G "$INFO/*.list" >/dev/null; then
    sort -u "$INFO"/*.list | while IFS= read -r f; do
      [[ -e "$ROOT$f" || -L "$ROOT$f" ]] || continue
      # A directory the system already has (/usr/bin, /usr/lib/...) is never bound over; its new
      # entries are bound one by one instead.
      [[ -d "$f" && -d "$ROOT$f" && ! -L "$ROOT$f" ]] && continue
      p="$f"; best="$f"
      while [[ "$p" == /*/* ]]; do
        if [[ -e "${p%/*}" ]]; then best="$p"; break; fi
        p="${p%/*}"; best="$p"
      done
      printf '%s\n' "$best"
    done | sort -u | while IFS= read -r best; do
      printf '%s\t%s\n' "$(tier_target "$ROOT$best")" "$best"
    done >"$tmp"
  fi
  mv "$tmp" "$BINDS"

  # Wrappers: drop ours, then one per executable in the tier's bin directories.
  local w name
  for w in "$BIN_DIR"/*; do
    [[ -f "$w" ]] && grep -qxF "$WRAP_MARK" "$w" 2>/dev/null && rm -f "$w"
  done
  for d in /usr/bin /usr/sbin /bin /sbin /usr/games; do
    [[ -d "$ROOT$d" ]] || continue
    for f in "$ROOT$d"/*; do
      [[ -L "$f" || ( -x "$f" && ! -d "$f" ) ]] || continue
      name="${f##*/}"
      [[ -e "$BIN_DIR/$name" ]] && continue  # never overwrite the user's own files
      printf '#!/bin/sh\n%s\nexec dad-apt exec %s "$@"\n' "$WRAP_MARK" "$d/$name" >"$BIN_DIR/$name"
      chmod 755 "$BIN_DIR/$name"
    done
  done
}

# add_alternatives creates the symlinks a package's postinst would register with
# update-alternatives --install LINK NAME PATH PRIO (for example /usr/bin/figlet), when LINK is not
# already on the system. Lines that use shell variables are skipped.
add_alternatives() {
  local deb="$1" pkg="$2" ctl link path
  ctl=$(mktemp -d)
  dpkg-deb -e "$deb" "$ctl"
  if [[ -f "$ctl/postinst" ]]; then
    # Join backslash-continued lines first: postinst scripts split long commands.
    sed -e ':a' -e '/\\$/N; s/\\\n//; ta' "$ctl/postinst" | grep -oE 'update-alternatives[[:space:]]+(--[a-z]+[[:space:]]+)*--install[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+' \
      | grep -v '\$' | while read -r -a w; do
        link="${w[-3]}"; path="${w[-1]}"
        [[ "$link" == /* && "$path" == /* ]] || continue
        [[ -e "$link" || -L "$link" || -e "$ROOT$link" || -L "$ROOT$link" ]] && continue
        mkdir -p "$ROOT${link%/*}"
        ln -s "$path" "$ROOT$link"
        echo "$link" >>"$INFO/$pkg.list"
      done
  fi
  rm -rf "$ctl"
}

cmd_install() {
  (( $# )) || die "usage: dad-apt install PKG..."
  init
  lists_fresh || cmd_update
  rm -f "$TIER/archives/"*.deb
  # Download only: apt resolves against the image's dpkg database, so dependencies the image already
  # has are not fetched again.
  apt-get "${apt_opts[@]}" -q -y -d install "$@"
  local debs=("$TIER/archives/"*.deb)
  if [[ ! -e "${debs[0]}" ]]; then
    echo "dad-apt: nothing to download: $* already in the image (or in the tier)"
    return 0
  fi
  local deb pkg ver
  for deb in "${debs[@]}"; do
    pkg=$(dpkg-deb -f "$deb" Package)
    ver=$(dpkg-deb -f "$deb" Version)
    dpkg-deb --fsys-tarfile "$deb" | tar -x -C "$ROOT" --no-same-owner --no-same-permissions \
      --exclude='./usr/share/doc' --exclude='./usr/share/man' --exclude='./usr/share/info' \
      --exclude='./usr/share/lintian' --exclude='./usr/share/bug'
    dpkg-deb --fsys-tarfile "$deb" | tar -t | sed -e 's|^\./|/|' -e 's|/$||' \
      | grep -v -E "$SKIP_RE" | grep -v -x '' | sort -u >"$INFO/$pkg.list"
    add_alternatives "$deb" "$pkg"
    echo "$ver" >"$INFO/$pkg.version"
    echo "unpacked $pkg $ver"
  done
  rm -f "${debs[@]}"
  cmd_refresh
}

cmd_remove() {
  (( $# )) || die "usage: dad-apt remove PKG..."
  init
  local pkg f others
  for pkg in "$@"; do
    [[ -f "$INFO/$pkg.list" ]] || die "$pkg is not installed in the tier"
    others=$(find "$INFO" -name '*.list' ! -name "$pkg.list" -exec cat {} + 2>/dev/null | sort -u)
    # Files first, deepest paths first, then directories left empty.
    sort -r "$INFO/$pkg.list" | while IFS= read -r f; do
      grep -qxF -- "$f" <<<"$others" && continue
      if [[ -d "$ROOT$f" && ! -L "$ROOT$f" ]]; then rmdir "$ROOT$f" 2>/dev/null || true; else rm -f "$ROOT$f"; fi
    done
    rm -f "$INFO/$pkg.list" "$INFO/$pkg.version"
    echo "removed $pkg"
  done
  cmd_refresh
}

cmd_list() {
  init
  local v
  for v in "$INFO"/*.version; do
    [[ -e "$v" ]] || continue
    printf '%s\t%s\n' "$(basename "$v" .version)" "$(cat "$v")"
  done
}

# run_view execs argv under proot with every tier path bound over its real path. The bind list is
# recomputed when the image's dpkg database is newer than it (a new image may add directories).
run_view() {
  # Already inside a view (a wrapper called from dad-apt shell, or one tier command running
  # another): the paths are bound, so run directly instead of nesting proot.
  if [[ "${DAD_APT_VIEW:-}" == 1 ]]; then exec "$@"; fi
  init
  if [[ ! -f "$BINDS" || /var/lib/dpkg/status -nt "$BINDS" ]]; then cmd_refresh >/dev/null; fi
  local args=() src dst
  while IFS=$'\t' read -r src dst; do
    [[ -n "$dst" ]] && args+=(-b "$src:$dst")
  done <"$BINDS"
  DAD_APT_VIEW=1 exec proot "${args[@]}" "$@"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list) cmd_list ;;
  update) cmd_update ;;
  refresh) cmd_refresh ;;
  exec) shift; (( $# )) || die "usage: dad-apt exec CMD [ARG...]"; run_view "$@" ;;
  shell) shift; run_view /bin/bash "$@" ;;
  ""|-h|--help|help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; [[ -n "${1:-}" ]] ;;
  *) die "unknown command $1 (try dad-apt help)" ;;
esac
